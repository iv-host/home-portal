{
  "realm": "home-portal",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "home-portal",
      "name": "Home Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "home-portal-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/oauth2/redirect"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@domain.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    },
    {
      "username": "user",
      "email": "user@domain.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ]
}
