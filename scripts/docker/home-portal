#!/bin/sh

set -eu

usage() {
  echo "Usage: home-portal <backup|restore> <file>" >&2
}

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

command="$1"
file="$2"

case "$command" in
  backup)
    operation="export"
    ;;
  restore)
    operation="restore"
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage
    exit 2
    ;;
esac

if [ -z "${DATABASE_URL:-}" ]; then
  echo "'DATABASE_URL' env variable is required" >&2
  exit 1
fi

set -- \
  "-Dspring.liquibase.enabled=true" \
  "-Dspring.liquibase.change-log=classpath:/database/db.changelog-root.yml" \
  "-Dspring.datasource.url=${DATABASE_URL}"

if [ -n "${DATABASE_USERNAME:-}" ]; then
  set -- "$@" "-Dspring.datasource.username=${DATABASE_USERNAME}"
fi

if [ -n "${DATABASE_PASSWORD:-}" ]; then
  set -- "$@" "-Dspring.datasource.password=${DATABASE_PASSWORD}"
fi

exec java "$@" -jar /app/home-portal.jar backup "$operation" "$file"
